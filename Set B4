<?php
$xmlFile = "univer.xml";

if (file_exists($xmlFile)) {
    $xml = simplexml_load_file($xmlFile);
    
    // XPath expression to select all <uname> elements
    $name = $xml->xpath("//uname");

    echo "<h3>List of University Names:</h3>";
    foreach ($name as $uname) {
        echo $uname . "<br>";
    }
} else {
    echo "File not exists!";
}
?>
